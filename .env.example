PORT=3001
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=change-this-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# OpenAI (leave empty to run in mock mode)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=dall-e-3

# Optional: skip live WordPress calls even if credentials are provided
MOCK_WP=false

# Save every API, WordPress, and OpenAI request/response to logs/http-YYYY-MM-DD.jsonl
# Can also be toggled in the studio UI
DEBUG_LOGS=false

# Local Docker cPanel-like stack: docker compose up -d
# Studio fields, for example: URL http://localhost:8080/site1  path /home/deploy/public_html/site1
SSH_HOST=127.0.0.1
# SSH port on the server (22 for typical cPanel, 2222 for local Docker). Also set this in Vercel env.
SSH_PORT=2222
SSH_USERNAME=deploy
SSH_PASSWORD=
SSH_PRIVATE_KEY_PATH=
SSH_PRIVATE_KEY="-----BEGIN OPENSSH PRIVATE KEY-----
...
-----END OPENSSH PRIVATE KEY-----"
# Required if the key above asks for a password when you use ssh locally
SSH_PRIVATE_KEY_PASSPHRASE=

# MySQL host as WordPress sees it on the SSH server (localhost on cPanel, db in local Docker)
WP_DB_HOST=localhost

# Pulled from Vercel with `npm run env:vercel` into `.env.local` (overrides this file).
# Or leave empty to keep site_configs/ and themes/ on disk.
BLOB_READ_WRITE_TOKEN=

# Database name/user/password are per-site (Site settings).
# From the hosting container the MariaDB host is `db`. From the Mac: 127.0.0.1:3307
# Pre-created per-site DBs (like cPanel): site1/site1pass, site2/site2pass, site3/site3pass
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=
WP_ADMIN_EMAIL=admin@localhost.local
WP_EDITOR_USER=editor
